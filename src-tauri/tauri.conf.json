{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lyre",
  "version": "1.0.1",
  "identifier": "app.glassplayer.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyre",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Lyre",
    "copyright": "© 2026 Lyre",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzNzJBNEIyREMxQTFCOUUKUldTZUd4cmNzcVJ5SXg4TXV0Z2V6WnBIMEpHWk0vV3pLVy9uN29MY1Jkdk8wclcyVXRrTHVZb3EK",
      "endpoints": [
        "https://github.com/Lypey/lyre/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
